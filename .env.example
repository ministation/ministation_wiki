# --- Site ---
SITE_NAME=Вики Мини-станции
SITE_PUBLIC_URL=https://wiki.ministation.ru
MAIN_SITE_URL=https://ministation.ru
DEFAULT_PAGE=Main_Page
MW_LANG=ru
MW_VERSION=1.45.1
MW_ADMIN=Admin
MW_ADMIN_PASS=changeme_admin
# MW_SCRIPT_PATH=
# MW_DIR=

# --- PHP (minimum 8.4; Ubuntu Questing ships 8.4) ---
# PHP_BIN=php
# Optional: skip download if network truncates the tarball
# MW_TARBALL=/tmp/mediawiki-1.45.1.tar.gz
# How to fetch MediaWiki: git (default, reliable) | tarball | auto
# MW_FETCH=git

# --- PostgreSQL (install / admin user for CREATE DATABASE) ---
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
# On Ubuntu leave empty — setup uses `sudo -u postgres` (peer auth).
# For TCP auth set a password:
# PGPASSWORD=your_postgres_password
PGPASSWORD=
WIKI_DB=ministation_wiki
WIKI_DB_USER=wiki
WIKI_DB_PASS=wiki_pass
WIKI_DB_SCHEMA=mediawiki

# --- Runtime ---
# Bind address: 0.0.0.0 = listen on all interfaces (public access)
WIKI_HOST=0.0.0.0
WIKI_PORT=3000
SPRITE_HOST=0.0.0.0
SPRITE_PORT=3001
# Public URLs for browsers (NEVER use 0.0.0.0 here):
SITE_PUBLIC_URL=http://144.31.0.187:3000
SPRITE_PUBLIC_URL=http://144.31.0.187:3001
# Optional explicit override for MediaWiki $wgServer:
# MW_SERVER=http://144.31.0.187:3000

# --- SS14 Resources (Textures for {{#sprite:}}) ---
# After `python -m tools sprites` this is set automatically:
# SS14_RESOURCES=/home/ss14_user/ministation_wiki/data/ss14_repo/Resources
# Or point at your build:
# SS14_RESOURCES=/path/to/mini-station-goob/Resources
# Git source (sparse-clone only Resources/Textures):
SS14_RESOURCES_GIT=https://github.com/ministation/mini-station-goob.git
SS14_RESOURCES_REF=master
SPRITE_SCALE=2
