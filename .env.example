# --- Site ---
SITE_NAME=Вики Мини-станции
SITE_PUBLIC_URL=https://wiki.ministation.ru
MAIN_SITE_URL=https://ministation.ru
DEFAULT_PAGE=Main_Page
MW_LANG=ru
MW_VERSION=1.45.1
MW_ADMIN=Admin
MW_ADMIN_PASS=changeme_admin
# MW_SCRIPT_PATH=
# MW_DIR=

# --- PHP (recommended: 8.5.x latest stable) ---
# PHP_BIN=php
# On Windows after winget: PHP_BIN=C:\Users\...\AppData\Local\Microsoft\WinGet\Packages\PHP.PHP.8.5_...\php.exe

# --- PostgreSQL (install / admin user for CREATE DATABASE) ---
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
WIKI_DB=ministation_wiki
WIKI_DB_USER=wiki
WIKI_DB_PASS=wiki_pass
WIKI_DB_SCHEMA=mediawiki

# --- Runtime ports ---
WIKI_HOST=127.0.0.1
WIKI_PORT=3000
SPRITE_HOST=127.0.0.1
SPRITE_PORT=3001
# Behind Caddy use the public wiki origin (extension appends /sprite/…):
# SPRITE_PUBLIC_URL=https://wiki.ministation.ru
# Local default (tools/start):
SPRITE_PUBLIC_URL=http://127.0.0.1:3001

# --- SS14 Resources (folder that contains Textures/) ---
# SS14_RESOURCES=/path/to/mini-station-goob/Resources
SPRITE_SCALE=2
