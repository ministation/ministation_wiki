[Unit]
Description=Mini Station Wiki (MediaWiki)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ss14_user
Group=ss14_user
WorkingDirectory=/home/ss14_user/ministation_wiki
EnvironmentFile=/home/ss14_user/ministation_wiki/.env
Environment=MW_SERVER=https://wiki.ministation.ru
ExecStart=/usr/bin/php -S 127.0.0.1:3000 /home/ss14_user/ministation_wiki/tools/php_router.php
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
