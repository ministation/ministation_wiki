{{! MiniStation skin — page chrome closer to TGUI }}
<div class="bg-grid" aria-hidden="true"></div>
<header class="topbar">
	<div class="topbar-inner">
		<a class="logo" href="{{link-mainpage}}">
			{{#data-logos}}
			<img class="logo-img" src="{{icon}}" width="42" height="42" alt="Мини-станция" decoding="async">
			{{/data-logos}}
			{{^data-logos}}
			<img class="logo-img" src="/skins/MiniStation/resources/logo.png" width="42" height="42" alt="Мини-станция" decoding="async">
			{{/data-logos}}
			<h1 class="logo-text">Мини<span>-</span>вики</h1>
		</a>
		{{#data-search-box}}
		<form class="search" action="{{form-action}}" method="get" role="search">
			<label class="sr-only" for="searchInput">{{msg-search}}</label>
			{{{html-input}}}
			{{{html-button-search}}}
		</form>
		{{/data-search-box}}
		<div class="topbar-actions">
			<button type="button" class="icon-btn theme-toggle tgui-btn tgui-btn--quiet" id="themeToggle" title="Тема" aria-label="Сменить тему">◐</button>
			<a class="btn btn-site tgui-btn" href="https://ministation.ru" target="_blank" rel="noopener">Сайт</a>
			{{#data-portlets}}
				{{#data-user-menu}}
				<nav class="user-cluster" aria-label="Учётная запись">{{>PortletInline}}</nav>
				{{/data-user-menu}}
			{{/data-portlets}}
		</div>
	</div>
</header>

<div class="shell">
	<aside class="sidebar">
		<div class="side-group">
			{{#data-portlets-sidebar.data-portlets-first}}{{>Portlet}}{{/data-portlets-sidebar.data-portlets-first}}
			{{#data-portlets-sidebar.array-portlets-rest}}{{>Portlet}}{{/data-portlets-sidebar.array-portlets-rest}}
		</div>
		<div class="side-note">
			Спрайты SS14 в статьях — см. <a href="/index.php?title=Sprite_Help">справку</a>.
		</div>
	</aside>

	<main class="content" id="content" role="main">
		<article class="wiki-page mw-body">
			<header class="page-head">
				<div class="page-actions" role="navigation" aria-label="Действия со страницей">
					<div class="page-actions__left">
						{{#data-portlets}}
							{{#data-associated-pages}}{{>PortletInline}}{{/data-associated-pages}}
						{{/data-portlets}}
					</div>
					<div class="page-actions__right">
						{{#data-portlets}}
							{{#data-views}}{{>PortletInline}}{{/data-views}}
							{{#data-actions}}{{>PortletInline}}{{/data-actions}}
						{{/data-portlets}}
					</div>
				</div>
				{{#array-indicators}}
				<div class="mw-indicators">{{{html}}}</div>
				{{/array-indicators}}
				{{{html-title-heading}}}
				{{#html-subtitle}}<div id="contentSub" class="lede">{{{html-subtitle}}}</div>{{/html-subtitle}}
			</header>
			<div id="bodyContent" class="prose mw-body-content">
				{{{html-body-content}}}
				{{{html-categories}}}
				{{{html-after-content}}}
			</div>
		</article>
	</main>
</div>

<footer class="footer">
	<div class="footer-inner">
		<p>Вики <strong>Мини-станции</strong> · как на <a href="https://ministation.ru">ministation.ru</a></p>
		{{#data-footer}}
			{{#data-places}}{{>FooterList}}{{/data-places}}
			{{#data-icons}}{{>FooterList}}{{/data-icons}}
		{{/data-footer}}
	</div>
</footer>
